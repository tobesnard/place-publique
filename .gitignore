# Ce fichier couvre le dépôt multi-projets (racine).
# Chaque sous-projet (backend-springboot, frontend-angular, frontend-react)
# possède son propre .gitignore pour ses spécificités (target/, dist/, node_modules/, etc.)

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDEs / éditeurs
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.iml
*.suo
*.user

# Logs
*.log
logs/

# Variables d'environnement / secrets
.env
.env.*
!.env.example

# Docker
docker-compose.override.yml

# Archives / fichiers temporaires
*.tmp
*.bak
*.swp
