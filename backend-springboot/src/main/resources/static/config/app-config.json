{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "app": {
        "name": "Place Publique",
        "slug": "place-publique",
        "version": "0.2.0",
        "environment": "development",
        "metadata": {
            "title": "Place Publique",
            "description": "Place Publique est une application dédiée à l'échange entre les citoyens.",
            "author": "Tony Besnard",
            "language": "fr",
            "charset": "UTF-8",
            "keywords": [
                "web",
                "application",
                "dashboard"
            ],
            "favicon": "/assets/icons/favicon.ico",
            "openGraph": {
                "ogTitle": "Place Publique",
                "ogDescription": "Place Publique est une application dédiée à l'échange entre les citoyens.",
                "ogImage": "/assets/images/og-cover.png",
                "ogType": "website"
            }
        }
    },
    "ui": {
        "theme": {
            "defaultMode": "dark",
            "allowUserToggle": true,
            "colors": {
                "primary": "#F07167",
                "secondary": "#7BAF9E",
                "accent": "#E1A95F",
                "terracotta": "#B26B4A",
                "darkSlate": "#3D4852",
                "light": {
                    "background": "#FAF8F5",
                    "surface": "#FFFFFF",
                    "text": "#3D4852",
                    "border": "#E1A95F"
                },
                "dark": {
                    "background": "#1A1A22",
                    "surface": "#2D353C",
                    "text": "#FAF8F5",
                    "border": "#7BAF9E"
                }
            },
            "typography": {
                "fontFamily": "Montserrat, Open Sans, system-ui, sans-serif",
                "fontSizeBase": "16px",
                "borderRadius": "8px"
            }
        },
        "layout": {
            "header": {
                "fixed": true,
                "showLogo": true,
                "showSearch": true
            },
            "sidebar": {
                "enabled": true,
                "defaultCollapsed": false,
                "position": "left"
            },
            "footer": {
                "enabled": true,
                "copyright": "© 2026 Place Publique. Tous droits réservés."
            }
        }
    },
    "features": {
        "darkMode": true,
        "notifications": true,
        "analytics": false
    },
    "api": {
        "baseUrl": "https://api.place-publique.com/v1",
        "timeoutMs": 5000
    },
    "resources": {
        "icon": "img/icon.png"
    },
    "frontends": {
        "react": "http://localhost:5173",
        "angular": "http://localhost:4200"
    }
}